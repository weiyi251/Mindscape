# ============================================================================
# .gitignore —— 内容取自开发计划书 17.9，并额外补充两行（见文末「补充」）
# ============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
src-tauri/target/

# Tauri
src-tauri/gen/

# Local data & personal paths
.mindscape/
*.local
*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*

# --- 补充（17.9 未列出，但对应第十六章「个人信息误提交」风险项）---
# 本机的 Agent 工作区数据（含记忆、日志、临时诊断脚本），属个人数据，不得开源
.workbuddy/
.tmp-tools/

# Vite 打包 vite.config.ts 时生成的临时文件；进程被强制结束时会残留
vite.config.ts.timestamp-*.mjs

# 自动更新签名私钥：应存放在仓库之外（默认 %USERPROFILE%\.tauri\mindscape.key）。
# 这里加一道保险，防止误放进来后被提交 —— 私钥泄露等于任何人都能伪造更新包。
# 公钥是纯文本，直接写在 tauri.conf.json 的 plugins.updater.pubkey 里，不需要文件。
*.key

# 本机 git 事故备份与 ZCode 会话工具配置（个人数据，不入库）
.git.bak-*/
.zcodeignore
